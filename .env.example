# civicbot hosted settings. Copy to .env and fill in. NEVER commit .env.
# Generate secrets with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"                               # SESSION_SECRET
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"  # CIVICBOT_TOKEN_KEY

# 1 = fake X + offline city data, no credentials needed (local click-through). Leave 0 in production.
CIVICBOT_DEV_MODE=0

# Public https URL of the site. The X callback URL is PUBLIC_BASE_URL + /auth/x/callback (exact match).
PUBLIC_BASE_URL=https://civicbot.example.org

# X developer app (OAuth 2.0, type "Web App, Automated App or Bot" = confidential client)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Signs session cookies (32+ chars)
SESSION_SECRET=
# Fernet key: encrypts robot OAuth tokens + PKCE verifiers at rest. Losing it = every robot must reconnect.
CIVICBOT_TOKEN_KEY=

# Database. Default: SQLite on the /data volume. Postgres: postgresql+psycopg://user:pass@host:5432/civicbot
DATABASE_URL=sqlite:////data/civicbot.db

# Guardrails (see README "Costs"; X pay-per-use, billed to the app owner)
CIVICBOT_DAILY_SPEND_CAP_USD=5.00
CIVICBOT_ROBOT_DAILY_REPLIES=50
CIVICBOT_ROBOT_DAILY_MENTIONS=200
CIVICBOT_APP_POLLS_PER_15MIN=300
CIVICBOT_APP_POSTS_PER_DAY=9000
CIVICBOT_POLL_INTERVAL_S=120
CIVICBOT_WORKER_TICK_S=15
CIVICBOT_MAX_ROBOTS_PER_OWNER=3
CIVICBOT_SIGNUP_RATE_LIMIT=20
CIVICBOT_LOOKUP_RATE_LIMIT=20

# 0 = shadow mode: robots read mentions and log what they WOULD reply, posting nothing. Flip to 1 at launch.
CIVICBOT_X_WRITE_ENABLED=0
# Real 311 filing (also needs per-city API keys, JSON: {"bloomington-in": "..."}). Keep 0 until cities agree.
CIVICBOT_ALLOW_311_SENDING=0
CIVICBOT_CITY_API_KEYS={}

# 1 = run the worker loop inside the web process (single machine/volume deploys, e.g. Fly.io or Render
# with SQLite). Leave 0 when you run `python -m civicbot.web.worker` as its own process (docker-compose).
CIVICBOT_EMBEDDED_WORKER=0

# Only behind your own reverse proxy / platform router: trust X-Forwarded-For for rate limiting
CIVICBOT_TRUST_PROXY=1
