{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/fitzyracing1/civicbot/skill-spec-v1.json",
  "title": "civicbot skill spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "name",
    "description",
    "kind",
    "triggers",
    "request",
    "allowed_domains",
    "response"
  ],
  "properties": {
    "spec_version": {
      "enum": [
        1
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,48}$"
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 5,
      "maxLength": 400
    },
    "kind": {
      "enum": [
        "read",
        "write"
      ]
    },
    "version": {
      "type": "string",
      "maxLength": 20
    },
    "author": {
      "type": "string",
      "maxLength": 80
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 300
        },
        "attribution": {
          "type": "string",
          "maxLength": 120
        },
        "notes": {
          "type": "string",
          "maxLength": 400
        }
      }
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keywords"
      ],
      "properties": {
        "keywords": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          }
        },
        "phrases": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 60
          }
        },
        "min_score": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "inputs": {
      "type": "object",
      "maxProperties": 8,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern"
        ],
        "properties": {
          "regex": {
            "type": "string",
            "maxLength": 200
          },
          "default": {
            "type": "string",
            "maxLength": 100
          },
          "pattern": {
            "type": "string",
            "maxLength": 100
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url",
        "path",
        "method"
      ],
      "properties": {
        "base_url": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+(:443)?$"
        },
        "path": {
          "type": "string",
          "pattern": "^/[^\\s?#]*$",
          "maxLength": 300
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "params": {
          "type": "object",
          "maxProperties": 25,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "headers": {
          "type": "object",
          "maxProperties": 10,
          "additionalProperties": {
            "type": "string",
            "maxLength": 200
          }
        },
        "body": {
          "type": "object",
          "maxProperties": 25,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "body_format": {
          "enum": [
            "json",
            "form"
          ]
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "none",
            "api_key",
            "bearer"
          ]
        },
        "in": {
          "enum": [
            "header",
            "query"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_$.-]{1,40}$"
        },
        "secret_ref": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,40}$"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "allowed_domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"
      }
    },
    "location": {
      "enum": [
        "none",
        "optional",
        "required"
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replies"
      ],
      "properties": {
        "extract": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "type": "string",
            "maxLength": 200
          }
        },
        "list": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "item"
          ],
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 100
            },
            "item": {
              "type": "string",
              "maxLength": 140
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "join": {
              "type": "string",
              "maxLength": 5
            },
            "skip_past": {
              "type": "string",
              "maxLength": 200
            },
            "require": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "string",
                "maxLength": 100
              }
            },
            "sort": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "replies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 270
          }
        },
        "empty_replies": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 270
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_s": {
          "type": "number",
          "minimum": 1,
          "maximum": 15
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "min_interval_s": {
          "type": "number",
          "minimum": 1,
          "maximum": 3600
        },
        "max_calls_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "handler": {
      "type": "string",
      "pattern": "^builtin:[a-z_]+$"
    }
  }
}
