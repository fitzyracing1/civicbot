{
  "spec_version": 1,
  "name": "open-meteo-tomorrow",
  "title": "Tomorrow's forecast (Open-Meteo)",
  "description": "Tomorrow's high, low, conditions and chance of rain for the place you mention (or your home city). No key.",
  "kind": "read",
  "version": "1.0.0",
  "author": "civicbot catalog",
  "cost": "free",
  "api_id": "open-meteo-forecast",
  "terms": {
    "url": "https://open-meteo.com/en/terms",
    "attribution": "Weather data by Open-Meteo.com (CC BY 4.0)",
    "notes": "Free for non-commercial use under 10,000 calls/day; commercial use needs an Open-Meteo API plan."
  },
  "triggers": {
    "keywords": [
      "tomorrow",
      "tmrw",
      "tomorrow's"
    ],
    "phrases": [
      "weather tomorrow",
      "forecast tomorrow",
      "rain tomorrow",
      "tomorrow's weather"
    ]
  },
  "location": "required",
  "request": {
    "base_url": "https://api.open-meteo.com",
    "path": "/v1/forecast",
    "method": "GET",
    "params": {
      "latitude": "{location.lat}",
      "longitude": "{location.lng}",
      "daily": "temperature_2m_max,temperature_2m_min,precipitation_probability_max,weather_code",
      "temperature_unit": "fahrenheit",
      "timezone": "auto",
      "forecast_days": 2
    }
  },
  "auth": {
    "type": "none"
  },
  "allowed_domains": [
    "api.open-meteo.com"
  ],
  "response": {
    "extract": {
      "hi": "daily.temperature_2m_max.1",
      "lo": "daily.temperature_2m_min.1",
      "pop": "daily.precipitation_probability_max.1",
      "code": "daily.weather_code.1",
      "day": "daily.time.1"
    },
    "replies": [
      "Tomorrow in {location.text}: {code|wmo}, high {hi|round}°F, low {lo|round}°F, {pop|round}% chance of rain. Data: Open-Meteo",
      "{location.text} on {day}: {code|wmo}, {hi|round}°F / {lo|round}°F, rain chance {pop|round}%. (Open-Meteo)",
      "Forecast for tomorrow, {location.text}: high {hi|round}°F, low {lo|round}°F, {code|wmo}; {pop|round}% rain. Source: Open-Meteo"
    ]
  },
  "limits": {
    "timeout_s": 10,
    "max_bytes": 262144,
    "min_interval_s": 5,
    "max_calls_per_day": 200
  }
}
