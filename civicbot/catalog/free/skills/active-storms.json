{
  "spec_version": 1,
  "name": "active-storms",
  "title": "Active tropical storms (NOAA NHC)",
  "description": "Active Atlantic and Eastern/Central Pacific tropical cyclones from the National Hurricane Center. No key.",
  "kind": "read",
  "version": "1.0.0",
  "author": "civicbot catalog",
  "cost": "free",
  "api_id": "nhc-storms",
  "terms": {
    "url": "https://www.nhc.noaa.gov/aboutrss.shtml",
    "attribution": "Data: NOAA National Hurricane Center",
    "notes": "US government data, no key."
  },
  "triggers": {
    "keywords": [
      "hurricane",
      "hurricanes",
      "tropical",
      "cyclone",
      "nhc"
    ],
    "phrases": [
      "tropical storm",
      "any storms"
    ]
  },
  "location": "none",
  "request": {
    "base_url": "https://www.nhc.noaa.gov",
    "path": "/CurrentStorms.json",
    "method": "GET",
    "params": {}
  },
  "auth": {
    "type": "none"
  },
  "allowed_domains": [
    "www.nhc.noaa.gov"
  ],
  "response": {
    "list": {
      "path": "activeStorms",
      "item": "{name} ({classification}, {intensity} kt)",
      "max": 4,
      "join": "; "
    },
    "replies": [
      "Active tropical systems: {items}. Data: NOAA NHC",
      "NHC is tracking: {items}"
    ],
    "empty_replies": [
      "No active tropical storms in the Atlantic or Eastern/Central Pacific right now (NHC).",
      "The National Hurricane Center has no active storms at the moment."
    ]
  },
  "limits": {
    "timeout_s": 10,
    "max_bytes": 262144,
    "min_interval_s": 5,
    "max_calls_per_day": 200
  }
}
