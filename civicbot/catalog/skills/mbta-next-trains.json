{
  "spec_version": 1,
  "name": "mbta-next-trains",
  "title": "MBTA next departures (Boston)",
  "description": "Next MBTA departures at a stop, from the MBTA V3 API predictions endpoint. Give a stop id like place-pktrm (Park Street) or a bus stop number.",
  "kind": "read",
  "version": "1.0.0",
  "author": "civicbot catalog",
  "cost": "free",
  "api_id": "mbta-v3",
  "terms": {
    "url": "https://www.mbta.com/developers/v3-api",
    "attribution": "Data: MBTA",
    "notes": "No key: 20 requests/minute. Optional free key (secret_ref mbta_api_key) raises the limit to 1,000/minute."
  },
  "triggers": {
    "keywords": [
      "mbta",
      "train",
      "trains",
      "subway",
      "departures",
      "outbound",
      "inbound"
    ],
    "phrases": [
      "next train",
      "next t",
      "when is the train"
    ],
    "min_score": 1
  },
  "inputs": {
    "stop": {
      "regex": "\\b(place-[a-z0-9-]+|[0-9]{2,6})\\b",
      "default": "place-pktrm",
      "pattern": "^(place-[a-z0-9-]+|[0-9]{2,6})$",
      "description": "MBTA stop id; defaults to place-pktrm (Park Street)"
    }
  },
  "location": "none",
  "request": {
    "base_url": "https://api-v3.mbta.com",
    "path": "/predictions",
    "method": "GET",
    "params": {
      "filter[stop]": "{inputs.stop}",
      "sort": "departure_time",
      "page[limit]": 25,
      "fields[prediction]": "arrival_time,departure_time,direction_id"
    }
  },
  "auth": {
    "type": "api_key",
    "in": "header",
    "name": "x-api-key",
    "secret_ref": "mbta_api_key",
    "required": false
  },
  "allowed_domains": [
    "api-v3.mbta.com"
  ],
  "response": {
    "list": {
      "path": "data",
      "item": "{relationships.route.data.id} {attributes.departure_time||attributes.arrival_time|minutes_from_now} min",
      "skip_past": "attributes.departure_time||attributes.arrival_time",
      "sort": "attributes.departure_time||attributes.arrival_time",
      "max": 3,
      "join": ", "
    },
    "replies": [
      "Next at {inputs.stop}: {items}. Data: MBTA",
      "{inputs.stop} departures: {items} (MBTA)",
      "Leaving {inputs.stop} soon: {items}. Source: MBTA"
    ],
    "empty_replies": [
      "No upcoming MBTA departures predicted at {inputs.stop} right now.",
      "MBTA shows nothing leaving {inputs.stop} soon."
    ]
  },
  "limits": {
    "timeout_s": 8,
    "max_bytes": 262144,
    "min_interval_s": 3,
    "max_calls_per_day": 300
  }
}
